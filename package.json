{
  "name": "@luckys_luis/nuxt-laravelize-config",
  "version": "0.0.2",
  "description": "Shared configuration presets for nuxt-laravelize repositories",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "laravelize": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    },
    "./tsconfig": {
      "types": "./dist/tsconfig.d.ts",
      "import": "./dist/tsconfig.js"
    },
    "./oxlint": {
      "types": "./dist/oxlint.d.ts",
      "import": "./dist/oxlint.js"
    },
    "./dprint": {
      "types": "./dist/dprint.d.ts",
      "import": "./dist/dprint.js"
    },
    "./lefthook": {
      "types": "./dist/lefthook.d.ts",
      "import": "./dist/lefthook.js"
    },
    "./postinstall": {
      "types": "./dist/postinstall/index.d.ts",
      "import": "./dist/postinstall/index.js"
    },
    "./eslint-plugin": {
      "types": "./dist/eslint-plugin/index.d.ts",
      "import": "./dist/eslint-plugin/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "node ./dist/postinstall/index.js"
  },
  "dependencies": {
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "@typescript-eslint/parser": "^8.59.4",
    "@typescript-eslint/rule-tester": "^8.59.4",
    "@typescript-eslint/utils": "^8.59.4",
    "eslint": "^9.39.1",
    "oxlint": "^1.29.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
